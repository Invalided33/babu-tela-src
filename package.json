{
  "name": "babu-tela",
  "private": true,
  "license": "UNLICENSED",
  "description": "Ferramentas de desenvolvimento do Babu Tela (o app e o servidor são em Go)",
  "scripts": {
    "dev": "wails dev -skipbindings",
    "server": "go run ./cmd/babutela-server",
    "test": "go build -o bin/babutela-server.exe ./cmd/babutela-server && node tests/smoke.js",
    "release": "powershell -ExecutionPolicy Bypass -File build/release.ps1",
    "publicar": "powershell -ExecutionPolicy Bypass -File build/publicar-atualizacao.ps1",
    "servidor": "powershell -ExecutionPolicy Bypass -File deploy/deploy.ps1"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.9.0",
    "ws": "^8.22.0"
  }
}
